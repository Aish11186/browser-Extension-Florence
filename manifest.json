{
  "manifest_version": 3,
  "name": "Florence-2 Screen Watcher",
  "version": "0.1.0",
  "description": "Local WebGPU Florence-2 detection popup",
  "permissions": ["tabs", "activeTab", "scripting", "offscreen", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    { "resources": ["lib/*"], "matches": ["<all_urls>"] }
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
